{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "ignorePatterns": [
    "factory.js",
    "lms-project-hq-elite.jsx",
    "scripts/factory.js",
    "supabase/functions/**"
  ],
  "rules": {
